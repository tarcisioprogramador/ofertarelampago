# Banco de dados (Neon Postgres na nuvem)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/oferta-relampago?sslmode=require"

# Senha do painel admin (http://localhost:3000/admin/login)
ADMIN_PASSWORD="troque-esta-senha"

# Segredo da sessão do admin (gere um valor aleatório)
SESSION_SECRET="troque-este-segredo"

# URL pública do site
NEXT_PUBLIC_SITE_URL="https://ofertarelampago.vercel.app"

# ─── Assistente IA (admin) ─────────────────────────────────────────────

# Chave da API de IA (OpenAI, Google Gemini via endpoint OpenAI, OpenRouter, etc.)
AI_API_KEY=""

# URL base da API (padrão: OpenAI)
#   OpenAI:        https://api.openai.com/v1
#   OpenRouter:    https://openrouter.ai/api/v1
#   Gemini (OpenAI): https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL="https://api.openai.com/v1"

# Modelo usado (ex.: gpt-4o-mini, gemini-1.5-flash, openai/gpt-4o-mini)
AI_MODEL="gpt-4o-mini"

# ─── Afiliados ──────────────────────────────────────────────────────────

# Mercado Livre — ID do afiliado (aparece como matt_tool nos links)
MELI_AFFILIATE_ID=""

# Mercado Livre — palavra-chave da campanha (matt_word, ex: fontenelle413)
MELI_AFFILIATE_WORD=""

# Amazon Brasil — Store ID do Programa de Associados (tag)
AMAZON_AFFILIATE_TAG=""

# Magazine Luiza — slug da loja no Parceiro Magalu
MAGALU_AFFILIATE_SLUG=""
